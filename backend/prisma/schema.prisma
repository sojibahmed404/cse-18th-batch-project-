generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  CO_CR
  CR
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum NoticeType {
  BATCH
  COURSE
  QUIZ
  VIVA
  ASSIGNMENT
  LAB
  HOLIDAY
  EMERGENCY
  EVENT
}

enum MaterialType {
  SLIDE
  NOTE
  BOOK
  PREVIOUS_QUESTION
  LAB_MANUAL
  VIDEO
  OTHER
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  LATE
  GRADED
}

enum RoutineType {
  WEEKLY
  EXAM
  LAB
}

enum NotificationType {
  ASSIGNMENT
  NOTICE
  QUIZ
  DEADLINE
  SYSTEM
  LOGIN
  EVENT
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  password          String
  role              Role                @default(STUDENT)
  status            UserStatus          @default(PENDING)
  isEmailVerified   Boolean             @default(false)
  lastLoginAt       DateTime?
  loginAttempts     Int                 @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  student           Student?
  emailVerifications EmailVerification[]
  passwordResets    PasswordReset[]
  refreshTokens     RefreshToken[]
  loginLogs         LoginLog[]
  activityLogs      ActivityLog[]
  notifications     Notification[]
  assignmentSubmissions AssignmentSubmission[]
  publishedAssignments  Assignment[]     @relation("PublishedBy")
  publishedNotices      Notice[]         @relation("PublishedBy")
  uploadedMaterials     CourseMaterial[] @relation("UploadedBy")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Student {
  id               String    @id @default(uuid())
  userId           String    @unique
  studentId        String    @unique
  firstName        String
  lastName         String
  profilePicture   String?   @db.Text
  department       String    @default("Computer Science and Engineering")
  batch            Int       @default(18)
  currentSemester  String    @default("1-1")
  personalEmail    String?
  phone            String?
  bloodGroup       BloodGroup @default(UNKNOWN)
  address          String?   @db.Text
  emergencyContact String?
  github           String?
  linkedin         String?
  bio              String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([batch])
  @@map("students")
}

model Teacher {
  id          String   @id @default(uuid())
  name        String
  designation String
  department  String   @default("Computer Science and Engineering")
  email       String?  @unique
  phone       String?
  profilePicture String? @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  courses     Course[]

  @@map("teachers")
}

model Semester {
  id         String   @id @default(uuid())
  name       String   @unique
  displayName String
  year       Int
  term       Int
  isActive   Boolean  @default(false)
  isCurrent  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  courses    Course[]

  @@map("semesters")
}

model Course {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  credit        Float
  semesterId    String
  teacherId     String?
  description   String?  @db.Text
  syllabus      String?  @db.Text
  marksDistribution String? @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  semester      Semester @relation(fields: [semesterId], references: [id])
  teacher       Teacher? @relation(fields: [teacherId], references: [id])
  materials     CourseMaterial[]
  assignments   Assignment[]
  notices       Notice[]

  @@index([semesterId])
  @@index([code])
  @@map("courses")
}

model CourseMaterial {
  id           String       @id @default(uuid())
  courseId     String
  uploadedById String
  title        String
  description  String?      @db.Text
  type         MaterialType
  fileUrl      String       @db.Text
  fileName     String
  fileSize     Int?
  mimeType     String?
  downloadCount Int         @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  course       Course       @relation(fields: [courseId], references: [id])
  uploadedBy   User         @relation("UploadedBy", fields: [uploadedById], references: [id])

  @@index([courseId])
  @@index([type])
  @@map("course_materials")
}

model Assignment {
  id            String           @id @default(uuid())
  courseId      String
  publishedById String
  title         String
  description   String           @db.Text
  fileUrl       String?          @db.Text
  deadline      DateTime
  totalMarks    Int              @default(100)
  status        AssignmentStatus @default(DRAFT)
  allowLate     Boolean          @default(false)
  latePenalty   Int?             // percentage penalty
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  course        Course           @relation(fields: [courseId], references: [id])
  publishedBy   User             @relation("PublishedBy", fields: [publishedById], references: [id])
  submissions   AssignmentSubmission[]

  @@index([courseId])
  @@index([deadline])
  @@index([status])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  fileUrl      String?          @db.Text
  fileName     String?
  fileSize     Int?
  status       SubmissionStatus @default(NOT_SUBMITTED)
  marks        Int?
  feedback     String?          @db.Text
  submittedAt  DateTime?
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  student      User             @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model Notice {
  id           String     @id @default(uuid())
  publishedById String
  courseId     String?
  title        String
  content      String     @db.Text
  type         NoticeType
  isPinned     Boolean    @default(false)
  isArchived   Boolean    @default(false)
  fileUrl      String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  publishedBy  User       @relation("PublishedBy", fields: [publishedById], references: [id])
  course       Course?    @relation(fields: [courseId], references: [id])

  @@index([type])
  @@index([isPinned])
  @@map("notices")
}

model Routine {
  id        String      @id @default(uuid())
  type      RoutineType
  dayOfWeek Int?        // 0=Sunday, 6=Saturday (for weekly)
  startTime String?     // "08:00"
  endTime   String?     // "09:30"
  courseId  String?
  teacherName String?
  roomNumber  String?
  notes     String?     @db.Text
  examDate  DateTime?   // for exam routine
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([type])
  @@map("routines")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  eventDate   DateTime
  venue       String?
  imageUrl    String?  @db.Text
  isRegistrationOpen Boolean @default(false)
  registrationDeadline DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([eventDate])
  @@map("events")
}

model Gallery {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  imageUrl    String   @db.Text
  albumName   String
  createdAt   DateTime @default(now())

  @@index([albumName])
  @@map("gallery")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?  @db.Text
  device    String?
  browser   String?
  os        String?
  success   Boolean
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_logs")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  resource  String
  resourceId String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resource])
  @@map("activity_logs")
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  email     String
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([otp])
  @@map("email_verifications")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_resets")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("string")
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
